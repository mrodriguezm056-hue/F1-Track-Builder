local tabs = {"Circuitos", "Farming", "Settings"}
local tabButtons = {}
local tabContentFrames = {}

-- Contenedor General para las Páginas de las Pestañas
local PagesContainer = Instance.new("Frame")
PagesContainer.Size = UDim2.new(0.92, 0, 0, 275)
PagesContainer.Position = UDim2.new(0.04, 0, 0, 148)
PagesContainer.BackgroundTransparency = 1
PagesContainer.Parent = MainFrame

for i, tabName in ipairs(tabs) do
    local btnWidth = 1 / #tabs
    local tBtn = Instance.new("TextButton")
    tBtn.Text = tabName
    tBtn.Size = UDim2.new(btnWidth - 0.02, 0, 1, 0)
    tBtn.Position = UDim2.new((i - 1) * btnWidth, 0, 0, 0)
    tBtn.BackgroundColor3 = (i == 1) and Color3.fromRGB(114, 75, 215) or Color3.fromRGB(28, 28, 38)
    tBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tBtn.Font = Enum.Font.SourceSansBold
    tBtn.TextSize = 13
    tBtn.Parent = TabsContainer

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(0, 8)
    tCorner.Parent = tBtn
    tabButtons[tabName] = tBtn

    -- Crear la página correspondiente
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = (i == 1)
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 4
    page.Parent = PagesContainer
    tabContentFrames[tabName] = page

    local uiList = Instance.new("UIListLayout")
    uiList.SortOrder = Enum.SortOrder.LayoutOrder
    uiList.Padding = UDim.new(0, 8)
    uiList.Parent = page

    tBtn.MouseButton1Click:Connect(function()
        for name, frame in pairs(tabContentFrames) do
            frame.Visible = (name == tabName)
        end
        for name, b in pairs(tabButtons) do
            b.BackgroundColor3 = (name == tabName) and Color3.fromRGB(114, 75, 215) or Color3.fromRGB(28, 28, 38)
        end
    end)
end

-- Función para crear elementos de control (Toggles estilo XyronHub)
local function createToggle(parent, titleText, callback)
    local itemFrame = Instance.new("Frame")
    itemFrame.Size = UDim2.new(1, 0, 0, 48)
    itemFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    itemFrame.BorderSizePixel = 0
    itemFrame.Parent = parent

    local itemCorner = Instance.new("UICorner")
    itemCorner.CornerRadius = UDim.new(0, 8)
    itemCorner.Parent = itemFrame

    local label = Instance.new("TextLabel")
    label.Text = "  " .. titleText
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.TextColor3 = Color3.fromRGB(220, 220, 240)
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    label.Parent = itemFrame

    -- Switch Toggle
    local toggleBg = Instance.new("TextButton")
    toggleBg.Text = ""
    toggleBg.Size = UDim2.new(0, 46, 0, 24)
    toggleBg.Position = UDim2.new(1, -56, 0.5, -12)
    toggleBg.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    toggleBg.Parent = itemFrame

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggleBg

    local toggleCircle = Instance.new("Frame")
    toggleCircle.Size = UDim2.new(0, 18, 0, 18)
    toggleCircle.Position = UDim2.new(0, 3, 0.5, -9)
    toggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleCircle.Parent = toggleBg

    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = toggleCircle

    local active = false
    toggleBg.MouseButton1Click:Connect(function()
        active = not active
        if active then
            toggleBg.BackgroundColor3 = Color3.fromRGB(114, 75, 215)
            toggleCircle:TweenPosition(UDim2.new(1, -21, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        else
            toggleBg.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
            toggleCircle:TweenPosition(UDim2.new(0, 3, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        end
        callback(active)
    end)
end

