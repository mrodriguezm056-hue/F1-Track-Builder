createToggle(fPage, "Anti-AFK", function(state)
    antiAfkEnabled = state
end)

-- Bucle de Autofarm
task.spawn(function()
    while true do
        task.wait(2)
        if autoFarmEnabled then
            pcall(function()
                print("[Farm] Iniciando carrera de forma automática...")
            end)
        end
    end
end)

-- Sistema Anti-AFK
LocalPlayer.Idled:Connect(function()
    if antiAfkEnabled then
        VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(1)
        VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        print("[Anti-AFK] Acción de prevención ejecutada.")
    end
end)

